{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Myra-Agents/Myra-Agents-Plugins/schema/manifest.schema.json",
  "title": "Myra Agents plugin manifest",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Unique plugin name."
    },
    "version": {
      "type": "string",
      "description": "Semver, informational."
    },
    "exec": {
      "type": "string",
      "description": "Executable for the event-reaction role. Relative paths resolve against the plugin dir; bare names resolve on PATH."
    },
    "args": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Extra argv passed to exec."
    },
    "subscribes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Bus events forwarded to exec's stdin. [\"*\"] = all."
    },
    "providesAgents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agentPreset" },
      "description": "Agent presets this plugin contributes."
    },
    "config": {
      "type": "array",
      "items": { "$ref": "#/$defs/configField" },
      "description": "User-supplied settings, rendered as a form in the app. Each field's `key` is referenced by `webhooks` (urlFrom/secretFrom) and injected as an env var into any `exec`."
    },
    "webhooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/webhookSpec" },
      "description": "Webhook transport handled by the server core. Outbound POSTs on bus events; inbound exposes a signed HTTP route. Service specifics are declared here, not coded."
    },
    "catalog": {
      "$ref": "#/$defs/catalog",
      "description": "Display metadata for the in-app catalog and the trigger picker: human name, icon, role verbs. Optional; surfaced (opaquely) via list_plugins."
    }
  },
  "$defs": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Human-friendly display name (folder name otherwise)." },
        "icon": { "type": "string", "description": "Icon id the app maps to a glyph (e.g. mail, slack, github)." },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "verbs": {
          "type": "array",
          "items": { "enum": ["trigger", "action", "notify", "receive", "agent"] },
          "description": "User-facing capability tags. `trigger` = surfaces in the Add-Trigger picker."
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "summary": { "type": "string", "description": "One-line description shown under the trigger in the picker." } }
        },
        "actions": {
          "type": "array",
          "description": "Post-run actions this connector can perform (send an email, post a message…). Surfaced in the patrol editor's Actions picker; the config is rendered as a form and passed to the connector's runAction.",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "description": "Action type, dispatched to the adapter's actions[id] handler." },
              "label": { "type": "string" },
              "summary": { "type": "string" },
              "config": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "label", "type"],
                  "additionalProperties": false,
                  "properties": {
                    "key": { "type": "string", "description": "Config key (lowercase); values may template {{result}} {{title}} {{card.*}}." },
                    "label": { "type": "string" },
                    "type": { "enum": ["string", "secret", "boolean", "number"] },
                    "required": { "type": "boolean" },
                    "placeholder": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "configField": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Identifier; referenced by webhooks and injected as an env var name into exec."
        },
        "label": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["string", "secret", "boolean", "number", "select", "multiselect"],
          "description": "`secret` values are stored in the OS keychain, never in settings.json or logs."
        },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Choices for select/multiselect."
        },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "description": { "type": "string" },
        "placeholder": { "type": "string" }
      }
    },
    "webhookSpec": {
      "type": "object",
      "required": ["id", "direction"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique within the plugin." },
        "direction": {
          "enum": ["out", "in"],
          "description": "`out` = core POSTs on matching bus events. `in` = core exposes a signed HTTP route."
        },
        "urlFrom": {
          "type": "string",
          "description": "out only — config key whose value is the destination URL."
        },
        "events": {
          "type": "array",
          "items": { "type": "string" },
          "description": "out only — card statuses / bus event names that fire this webhook."
        },
        "template": {
          "type": "string",
          "description": "out only — mustache-lite body. {{card.title}}, {{card.status}}, {{card.agentResult}} substituted."
        },
        "route": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "in only — path segment under /hooks/<plugin>/<route>."
        },
        "verify": { "$ref": "#/$defs/verifySpec" },
        "action": {
          "type": "string",
          "description": "in only — rpc command to dispatch with the mapped payload (e.g. create_card)."
        },
        "map": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "in only — { rpcField: JSONPath } extracted from the inbound body."
        },
        "exec": {
          "type": "string",
          "description": "Optional escape hatch. Core invokes it request/response (raw request JSON on stdin → transformed payload / verify verdict on stdout) when named schemes/mapping don't fit."
        }
      }
    },
    "verifySpec": {
      "type": "object",
      "required": ["scheme"],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "enum": ["hmac-sha256", "slack", "stripe"],
          "description": "Named signature scheme implemented in the core."
        },
        "header": {
          "type": "string",
          "description": "Request header carrying the signature (e.g. X-Hub-Signature-256)."
        },
        "secretFrom": {
          "type": "string",
          "description": "Config key whose value is the shared signing secret."
        }
      }
    },
    "agentPreset": {
      "type": "object",
      "required": ["id", "name", "binary", "argsTemplate"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "binary": { "type": "string", "minLength": 1 },
        "argsTemplate": {
          "type": "string",
          "pattern": "\\{prompt\\}",
          "description": "Must contain the literal {prompt} placeholder."
        },
        "workingDir": { "type": "string" }
      }
    }
  }
}
